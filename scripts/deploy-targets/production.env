# production server — FILL THESE IN before using this target.
# SSH_TARGET="user@fill-me-in"
SSH_TARGET=""
REMOTE_DIR="/var/www/app.smalloffice.in"
# CRA env file to build with (copied to .env.production.local before build).
# frontend-document-designer has no .env.production yet — create it with
# real production REACT_APP_* values (API endpoints, keys, etc.) before
# this target can be used; it must NOT be a copy of .env.development.
REACT_ENV_FILE=".env.production"
