# dev/demo server (demo.smalloffice.in) — push from the `dev` branch.
#
# Own file (.env.demo, not .env.production) so it can sit on disk at the
# same time as production.env's file without one overwriting the other.
#
# .env.development (LAN IPs like 192.168.1.49) is NOT usable here — this is
# a public server. The OLD server-side `npm run build` must have been
# reading real values from a file already sitting in the server's
# checkout (not in this repo). Pull it once before first use:
#   ssh root@vmi3137091 cat /var/www/demo.smalloffice.in/.env.production > .env.demo
# then keep that file (gitignored, machine-local) for future builds.
REACT_ENV_FILE=".env.demo"
