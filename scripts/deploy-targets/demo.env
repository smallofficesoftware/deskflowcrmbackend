# dev/demo server — matches deploy-dev.sh's FRONTEND_DIR
SSH_TARGET="root@vmi3137091"
REMOTE_DIR="/var/www/demo.smalloffice.in"
# CRA env file to build with (copied to .env.production.local before build).
#
# .env.development (LAN IPs like 192.168.1.49) is NOT usable here — this is
# a public server. frontend-document-designer has no .env.production yet;
# the OLD server-side `npm run build` must have been reading real values
# from a file already sitting in the server's checkout (not in this repo).
# Pull it once before first use:
#   ssh root@vmi3137091 cat /var/www/demo.smalloffice.in/.env.production > .env.production
# then keep that file (gitignored, machine-local) for future builds.
REACT_ENV_FILE=".env.production"
