{
  "security.allowedUNCHosts": ["192.168.1.48", "192.168.1.232", "192.168.1.46"],
  "editor.mouseWheelZoom": true,
  "workbench.startupEditor": "none",
  "debug.terminal.clearBeforeReusing": true,
  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
    "blade": "html"
  },
  "code-runner.runInTerminal": true,
  "terminal.integrated.defaultProfile.windows": "Command Prompt",
  "explorer.confirmDelete": false,
  "security.workspace.trust.untrustedFiles": "open",
  "editor.suggestSelection": "first",
  "code-runner.clearPreviousOutput": true,
  "workbench.iconTheme": "material-icon-theme",
  "workbench.colorTheme": "Dark+",
  "workbench.editor.customLabels.patterns": {
    "**/app/**/page.tsx": "${dirname} - page.tsx",
    "**/app/**/layout.tsx": "${dirname} - layout.tsx",
    "**/app/**/index.tsx": "${dirname} - index.tsx"
  },
  "liveServer.settings.donotShowInfoMsg": true,
  "editor.linkedEditing": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "editor.fontFamily": "'Fira Code', 'FiraCode Nerd Font', Consolas, Courier New, monospace",
  "editor.fontLigatures": "true",
  "editor.fontSize": 15,
  "liveServer.settings.donotVerifyTags": true,
  "editor.guides.bracketPairs": true,
  "editor.wordWrap": "on",
  "editor.accessibilitySupport": "off",
  "javascript.updateImportsOnFileMove.enabled": "prompt",
  "git.autofetch": true,
  "editor.inlineSuggest.enabled": true,
  "git.openRepositoryInParentFolders": "never",
  "console-ninja.toolsToEnableSupportAutomaticallyFor": {
    "live-server-extension": true,
    "live-preview-extension": true
  },
  "codeium.enableConfig": {
    "*": true,
    "properties": true,
    "xml": true,
    "prisma": true,
    "ignore": true,
    "plaintext": true,
    "markdown": true,
    "code-runner-output": true,
    "instructions": true
  },
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "indentRainbow.updateDelay": 100,
  "indentRainbow.includedLanguages": [],
  "indentRainbow.colors": [
    "rgba(255,255,64,0.7)",
    "rgba(127,255,127,0.7)",
    "rgba(255,127,255,0.7)",
    "rgba(79,236,236,0.7)"
  ],
  "indentRainbow.indicatorStyle": "light",
  "indentRainbow.colorOnWhiteSpaceOnly": true,
  "indentRainbow.errorColor": "rgba(255,255,255,0)",
  "console-ninja.featureSet": "Community",
  "github.copilot.enable": {
    "*": false,
    "plaintext": true,
    "markdown": true,
    "scminput": false,
    "code-runner-output": false,
    "xml": true,
    "properties": true,
    "log": false
  },
  "gitlens.gitCommands.skipConfirmations": [
    "fetch:command",
    "stash-push:command",
    "switch:command",
    "branch-create:command"
  ],
  "git.enableSmartCommit": true,
  "terminal.integrated.cursorBlinking": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit",
    "source.fixAll.eslint": "explicit"
  },
  "editor.formatOnSave": true,
  "terminal.integrated.enableImages": true,
  "console-ninja.showWhatsNew": false,
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.suggest.enabled": true,
  "terminal.integrated.mouseWheelZoom": true,
  "terminal.integrated.gpuAcceleration": "on",
  "terminal.integrated.fontFamily": "'FiraCode Nerd Font', 'Fira Code', Consolas, Courier New, monospace",
  "terminal.integrated.enableFileLinks": "on",
  "liveServer.settings.port": 5500,
  "tailwindCSS.experimental.classRegex": [
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["cx\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
  ],
  "explorer.confirmDragAndDrop": false,
  "tailwindCSS.emmetCompletions": true,
  "php.validate.enable": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "html",
    "css"
  ],
  "terminal.integrated.fontLigatures.enabled": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "python.terminal.focusAfterLaunch": true,
  "codesnap.shutterAction": "copy",
  "codesnap.target": "container",
  "update.showReleaseNotes": false,
  "console-ninja.predictiveLoggingEnabled": false,
  "console-ninja.showWelcomeMessageInTools": false,
  "console-ninja.captureFunctions": true,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "redhat.telemetry.enabled": false,
  "react-native-tools.showUserTips": false,
  "projectManager.supportSymlinksOnBaseFolders": true,
  "projectManager.tags": ["Other", "Personal", "Work"],
  "projectManager.git.ignoredFolders": [
    "node_modules",
    "out",
    "typings",
    "test",
    ".haxelib",
    "dist"
  ],
  "python.analysis.typeCheckingMode": "standard",
  "terminal.integrated.env.windows": {},
  "github.copilot.nextEditSuggestions.enabled": true,
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter"
  },
  "terminal.integrated.fontSize": 18,
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "github.copilot.chat.codeGeneration.useInstructionFiles": true,
  "chat.agent.enabled": true,
  "chat.mcp.discovery.enabled": {
    "claude-desktop": true,
    "windsurf": true,
    "cursor-global": true,
    "cursor-workspace": true
  },
  "chat.mcp.gallery.enabled": true
}
