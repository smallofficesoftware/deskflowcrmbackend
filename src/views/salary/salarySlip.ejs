<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Salary Slip</title>
    <style>
      body { font-family: Arial, Helvetica, sans-serif; font-size: 12px; color: #000; margin: 0; padding: 0; }
      table.slip { width: 100%; border-collapse: collapse; border: 2px solid #000; table-layout: fixed; }
      table.slip td { border: 1px solid #000; padding: 6px 8px; vertical-align: middle; word-wrap: break-word; }
      .page { page-break-after: always; }
      .page.last { page-break-after: auto; }
      .company { font-size: 18px; font-weight: bold; }
      .addr { font-size: 11px; line-height: 1.5; }
      .label { width: 25%; background: #f2f2f2; font-weight: bold; }
      .val { width: 25%; }
      .num { text-align: right; }
      .bold { font-weight: bold; }
      .section { background: #d9d9d9; font-weight: bold; text-align: left; }
      .center { text-align: center; }
      .sub { background: #eeeeee; font-weight: bold; text-align: center; }
      .total-label { background: #f2f2f2; font-weight: bold; }
      .words { font-style: italic; }
      .sign-head { text-align: center; font-weight: bold; background: #f2f2f2; }
      .sign-space { height: 56px; text-align: center; vertical-align: middle; }
      .sign-space img { max-height: 48px; max-width: 220px; }
    </style>
  </head>
  <body>
    <% slips.forEach(function (s, idx) { %>
    <div class="page<%= idx === slips.length - 1 ? ' last' : '' %>">
      <table class="slip">
        <tr>
          <td colspan="2"><div class="company"><%= company.name %></div></td>
          <td colspan="2" class="addr">
            <%= company.address %><br />
            Email Id.: <%= company.email %>
          </td>
        </tr>
        <tr>
          <td class="label">Month</td>
          <td class="val bold"><%= monthLabel %></td>
          <td class="label">Slip Date</td>
          <td class="val bold"><%= slipDate %></td>
        </tr>
        <tr>
          <td class="section" colspan="2">Employee's Details</td>
          <td class="section" colspan="2">Attendance Details</td>
        </tr>
        <tr>
          <td class="label">Name</td>
          <td class="val"><%= s.employeeName %></td>
          <td class="label">Total Working days</td>
          <td class="val num"><%= s.totalWorkingDays %></td>
        </tr>
        <tr>
          <td class="label">Employee No.</td>
          <td class="val"><%= s.employeeNo %></td>
          <td class="label">Leave</td>
          <td class="val num"><%= s.leave %></td>
        </tr>
        <tr>
          <td class="label">Contact Number</td>
          <td class="val"><%= s.contactNumber %></td>
          <td class="label">Payable Days</td>
          <td class="val num"><%= s.payableDays %></td>
        </tr>
        <tr>
          <td class="section center" colspan="4">Salary Breakup</td>
        </tr>
        <tr>
          <td class="sub" colspan="2">Earnings</td>
          <td class="sub" colspan="2">Deduction</td>
        </tr>
        <% s.rows.forEach(function (r) { %>
        <tr>
          <td class="label"><%= r.earningLabel %></td>
          <td class="val num"><%= r.earningValue %></td>
          <td class="label"><%= r.deductionLabel %></td>
          <td class="val num"><%= r.deductionValue %></td>
        </tr>
        <% }) %>
        <tr>
          <td class="label">Remark :</td>
          <td colspan="3"><%= s.remark %></td>
        </tr>
        <tr>
          <td class="total-label">Gross</td>
          <td class="val num bold"><%= s.gross %></td>
          <td class="total-label">Total Deduction</td>
          <td class="val num bold"><%= s.totalDeduction %></td>
        </tr>
        <tr>
          <td class="total-label">Net Payable (INR)</td>
          <td class="val num bold"><%= s.netPayable %></td>
          <td colspan="2" class="words"><%= s.netPayableInWords %></td>
        </tr>
        <tr>
          <td class="sign-head" colspan="2">Employee's Sign</td>
          <td class="sign-head" colspan="2">Employer's Sign</td>
        </tr>
        <tr>
          <td class="sign-space" colspan="2"></td>
          <td class="sign-space" colspan="2">
            <% if (companySign) { %><img src="<%= companySign %>" alt="Employer's signature" /><% } %>
          </td>
        </tr>
      </table>
    </div>
    <% }) %>
  </body>
</html>
