<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <style>
    body { font-family: Arial, Helvetica, sans-serif; font-size: 11px; color: #212529; margin: 0; padding: 0; }
    h1 { font-size: 18px; margin: 0 0 4px 0; }
    h2 { font-size: 13px; margin: 14px 0 6px 0; }
    h3 { font-size: 12px; margin: 10px 0 4px 0; }
    .company { font-size: 12px; color: #55616a; margin-bottom: 8px; }
    .meta td { padding: 2px 8px 2px 0; vertical-align: top; }
    .meta td.k { width: 90px; color: #55616a; }
    table.grid { width: 100%; border-collapse: collapse; margin-bottom: 8px; }
    table.grid th, table.grid td { border: 1px solid #ced4da; padding: 4px 6px; text-align: left; }
    table.grid th { background: #f0f2f5; }
    td.n, th.n { text-align: right !important; }
    .short { color: #c0392b; font-weight: bold; }
    .foot { margin-top: 12px; font-size: 9px; color: #6c757d; }
  </style>
</head>
<body>
  <div class="company"><%= companyName %></div>
  <h1><%= title %></h1>

  <table class="meta">
    <% if (kind === "jobCard" && contact && contact.name) { %>
      <tr><td class="k">Customer</td><td><b><%= contact.name %></b></td></tr>
      <% if (contact.phone) { %><tr><td class="k">Contact No</td><td><b><%= contact.phone %></b></td></tr><% } %>
    <% } %>
    <tr><td class="k">Item</td><td><b><%= item.item_name %></b></td></tr>
    <% if (item.item_code) { %><tr><td class="k">Item Code</td><td><b><%= item.item_code %></b></td></tr><% } %>
    <% if (kind === "jobCard" && item.order_no) { %><tr><td class="k">Order No</td><td><b><%= item.order_no %></b></td></tr><% } %>
    <% if (targetQty !== null) { %><tr><td class="k">Target Qty</td><td><b><%= fmt(targetQty) %> <%= item.unit || "" %></b></td></tr><% } %>
  </table>

  <h2><%= kind === "bom" ? "Process and materials" : "Required Materials" %></h2>
  <% if (!processes.length) { %><div>No BOM processes.</div><% } %>

  <% processes.forEach(function (p) { %>
    <h3><%= p.process_name || "Process" %></h3>
    <% if (kind === "bom") { %>
      <table class="grid">
        <tr><th>Type</th><th>Material</th><th class="n">Qty</th><th>Unit</th></tr>
        <% p.consumption.forEach(function (m) { %>
          <tr><td>Consumption</td><td><%= m.material_name %></td><td class="n"><%= fmt(m.required_qty) %></td><td><%= m.unit || "" %></td></tr>
        <% }); %>
        <% p.rejection.forEach(function (m) { %>
          <tr><td>Rejection</td><td><%= m.material_name %></td><td class="n"><%= fmt(m.required_qty) %></td><td><%= m.unit || "" %></td></tr>
        <% }); %>
      </table>
    <% } else { %>
      <table class="grid">
        <tr><th>Type</th><th>Material</th><th class="n">Required</th><th class="n">Available</th><th class="n">Consumed</th><th class="n">Pending</th><th class="n">Diff</th></tr>
        <% [["Consumption", p.consumption], ["Rejection", p.rejection]].forEach(function (g) { g[1].forEach(function (m) {
             var pending = pendingOf(m); var diff = diffOf(m); %>
          <tr>
            <td><%= g[0] %></td>
            <td><%= m.material_name %></td>
            <td class="n"><%= fmt(m.required_qty) %> <%= m.unit || "" %></td>
            <td class="n"><%= fmt(m.available_qty) %></td>
            <td class="n"><%= fmt(m.consumed_qty) %></td>
            <td class="n"><%= fmt(pending) %></td>
            <td class="n <%= diff < 0 ? 'short' : '' %>"><%= fmt(diff) %></td>
          </tr>
        <% }); }); %>
      </table>
    <% } %>
  <% }); %>

  <div class="foot">Printed <%= printedAt %></div>
</body>
</html>
