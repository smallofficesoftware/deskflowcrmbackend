<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <style>
    body { font-family: Arial, Helvetica, sans-serif; font-size: 11px; color: #212529; margin: 0; padding: 0; }
    h1 { font-size: 18px; margin: 0 0 4px 0; }
    h3 { font-size: 12px; margin: 12px 0 4px 0; }
    .company { font-size: 12px; color: #55616a; margin-bottom: 8px; }
    .meta td { padding: 2px 8px 2px 0; vertical-align: top; }
    .meta td.k { width: 90px; color: #55616a; }
    table.grid { width: 100%; border-collapse: collapse; margin-bottom: 8px; }
    table.grid th, table.grid td { border: 1px solid #ced4da; padding: 4px 6px; text-align: left; }
    table.grid th { background: #f0f2f5; }
    td.n, th.n { text-align: right !important; }
    .foot { margin-top: 12px; font-size: 9px; color: #6c757d; }
  </style>
</head>
<body>
  <div class="company"><%= companyName %></div>
  <h1>Production Entry #<%= entry.id %></h1>

  <table class="meta">
    <tr><td class="k">Job Card</td><td><b>#<%= entry.job_id %></b></td></tr>
    <tr><td class="k">Produced</td><td><b><%= fmt(entry.produced_qty) %></b></td></tr>
    <tr><td class="k">Date</td><td><b><%= dateText %></b></td></tr>
    <tr><td class="k">Team member</td><td><b><%= entry.team_member_name || "-" %></b></td></tr>
    <% if (entry.total_actual_time > 0) { %><tr><td class="k">Time spent</td><td><b><%= duration(entry.total_actual_time) %></b></td></tr><% } %>
    <% if (entry.remark) { %><tr><td class="k">Remark</td><td><b><%= entry.remark %></b></td></tr><% } %>
  </table>

  <% (entry.processes || []).forEach(function (p) { %>
    <h3><%= p.process_name || "Process" %><% if (p.actual_time > 0) { %> (<%= duration(p.actual_time) %>)<% } %></h3>
    <table class="grid">
      <tr><th>Type</th><th>Material</th><th class="n">Qty</th><th>Warehouse</th></tr>
      <% p.consumption.forEach(function (m) { %>
        <tr><td>Consumption</td><td><%= m.material_name %></td><td class="n"><%= fmt(m.qty) %> <%= m.unit || "" %></td><td><%= m.warehouse_name || "" %></td></tr>
      <% }); %>
      <% p.rejection.forEach(function (m) { %>
        <tr><td>Rejection</td><td><%= m.material_name %></td><td class="n"><%= fmt(m.qty) %> <%= m.unit || "" %></td><td><%= m.warehouse_name || "" %></td></tr>
      <% }); %>
    </table>
  <% }); %>

  <div class="foot">Printed <%= printedAt %></div>
</body>
</html>
