<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <style>
    body { font-family: sans-serif; color: #000; padding: 20px; margin: 0; }
    h2 { text-align: center; border-bottom: 2px solid #000; padding-bottom: 10px; }
    /* Fixed layout: the server's fallback font is wider than the web's, and with
       auto layout the 8 columns (Consumed/Rejected can't wrap) ran past the page. */
    table { width: 100%; table-layout: fixed; border-collapse: collapse; margin-bottom: 20px; font-size: 12px; }
    th, td { border: 1px solid #000; padding: 6px 4px; text-align: left; word-wrap: break-word; overflow-wrap: break-word; word-break: break-word; }
    th { background-color: #f8f9fa; }
    .short { color: red; }
  </style>
</head>
<body>
  <!-- Same layout as the web's "Required Material Print" (RequiredMaterialPrint). -->
  <h2>REQUIRED MATERIAL - JOB CARD #<%= jobCardId %></h2>
  <p><strong>Item:</strong> <%= itemName %></p>

  <% processes.forEach(function (process, index) { %>
    <div>
      <h4><%= index + 1 %>. Process: <%= process.process_name %></h4>
      <table>
        <colgroup>
          <col style="width: 14%" />
          <col style="width: 14%" />
          <col style="width: 6%" />
          <col style="width: 11%" />
          <col style="width: 11%" />
          <col style="width: 15%" />
          <col style="width: 11%" />
          <col style="width: 18%" />
        </colgroup>
        <thead>
          <tr>
            <th>Type</th>
            <th>Material Name</th>
            <th>Unit</th>
            <th>Required Qty</th>
            <th>Available Qty</th>
            <th>Consumed/<wbr>Rejected</th>
            <th>Pending Qty</th>
            <th>Shortage/Diff</th>
          </tr>
        </thead>
        <tbody>
          <% [["Consumption", process.consumption], ["Rejection", process.rejection]].forEach(function (g) {
               g[1].forEach(function (m) { %>
            <tr>
              <td><%= g[0] %></td>
              <td><%= m.material_name %></td>
              <td><%= m.unit %></td>
              <td><%= f3(m.required_qty) %></td>
              <td><%= f3(m.available_qty) %></td>
              <td><%= f3(m.consumed_qty) %></td>
              <td><%= f3(pendingOf(m)) %></td>
              <td class="<%= diffOf(m) < 0 ? 'short' : '' %>"><%= f3(diffOf(m)) %></td>
            </tr>
          <% }); }); %>
        </tbody>
      </table>
    </div>
  <% }); %>
</body>
</html>
