<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <style>
    body { font-family: sans-serif; color: #000; padding: 20px; margin: 0; }
    h2 { text-align: center; border-bottom: 2px solid #000; padding-bottom: 10px; }
    table { width: 100%; border-collapse: collapse; margin-bottom: 20px; font-size: 12px; }
    th, td { border: 1px solid #000; padding: 6px; text-align: left; }
    th { background-color: #f8f9fa; width: 25%; }
  </style>
</head>
<body>
  <!-- Same layout as the web's "Print Job Card" (JobCardPrint). -->
  <h2>JOB CARD #<%= jobCardId %></h2>

  <h4>Customer Details</h4>
  <table>
    <tbody>
      <tr>
        <th>Customer Name</th><td><%= dash(contact.name) %></td>
        <th>Contact No</th><td><%= dash(contact.phone) %></td>
      </tr>
      <tr>
        <th>Email</th><td><%= dash(contact.email) %></td>
        <th>GST No</th><td><%= dash(contact.gst_no) %></td>
      </tr>
      <tr>
        <th>City</th><td><%= dash(contact.city) %></td>
        <th>Address</th><td><%= dash(contact.address) %></td>
      </tr>
    </tbody>
  </table>

  <h4>Item Details</h4>
  <table>
    <tbody>
      <tr>
        <th>Item Name</th><td><%= dash(item.item_name) %></td>
        <th>Item Code</th><td><%= dash(item.item_code) %></td>
      </tr>
      <tr>
        <th>Order No</th><td><%= dash(item.order_no) %></td>
        <th>Delivery Date</th><td><%= dash(item.delivery_date) %></td>
      </tr>
      <tr>
        <th>Order Qty</th>
        <td colspan="3"><strong><%= item.order_qty %> <%= item.unit || "" %></strong></td>
      </tr>
    </tbody>
  </table>
</body>
</html>
