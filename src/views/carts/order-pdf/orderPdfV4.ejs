<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <title>Invoice</title>
  <style>
    /* Global Styles */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
 @font-face {
      font-family: 'Poppins';
      src: url('/fonts/Poppins-Regular.ttf') format('truetype');
      font-weight: 400;
    }

    @font-face {
      font-family: 'Poppins';
      src: url('/fonts/Poppins-Medium.ttf') format('truetype');
      font-weight: 500;
    }

    @font-face {
      font-family: 'Poppins'; 
      src: url('/fonts/Poppins-Bold.ttf') format('truetype');
      font-weight: 600;
    }

    body {
      font-family: "Poppins", sans-serif;
      margin: 0;
      padding: 0;
      color: #333;
      z-index: 0;
      position: relative;
      min-height: 100vh;
    }

    /* Table Styling */
    table {
      width: 100%;
      border-collapse: collapse;
      z-index: 9999;
    }

    .now-rap-white-space{
      white-space: nowrap !important;
    }

    th,
    td {
      border: 1px solid #000;
      min-height: 15px !important;
      padding: 2px 5px;
      text-align: left;
    }

    th {
      text-align: center !important;
      font-weight: bold;
    }

    .bold {
      font-weight: bold;
      text-align: center !important;
    }

    .from-section,
    .to-section,
    .invoice-details {
      width: 33%;
    }

    .text-center {
      text-align: center !important;
    }

    strong {
      font-weight: bold;
    }
   .product-row-border td {
      border-bottom: 1px solid #000 !important;
    }

    @media print {
      @page {
        size: A5;
        margin: 0.2cm;
      }

      .invoice-items,
      .invoice-items tbody,
      .invoice-items tr,
      .total_summery,
      .gst_summery {
        page-break-inside: avoid !important;
      }

      .invoice-items thead {
        display: table-header-group;
      }

      .invoice-items tfoot {
        display: table-footer-group;
      }

      .page-break {
        page-break-before: always;
      }

      .invoice-container {
        width: 100% !important;
        max-width: none !important;
        margin: 0 !important;
      }
 .product-row-border td {
      border-bottom: 1px solid #000 !important;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
  }
      table {
        width: 100%;
        break-inside: avoid;
      }

      tr {
        break-inside: avoid;
      }

      .watermark {
        display: block !important;
      }

	 * {
	line-height: 5.5pt;

      
    }
      
    }

    .invoice-items tr td,
    .total_summery,
    .gst_summery {
      break-inside: avoid !important;
      page-break-inside: avoid !important;
    }

     * {
	line-height: 5.5pt;

      
    }
  </style>
</head>

<body>
  <%
      let orderType = orderTypesList.find((option) => Number(option.id) === cart.type) || {};
      let dynamicColor = "";
      if (orderType.id == 1) {
        dynamicColor = companyDetail.quotation_view_color || "#cfcfcf";
      } else if (orderType.id == 2) {
        dynamicColor = companyDetail.order_view_color || "#cfcfcf";
      } else if (orderType.id == 3) {
        dynamicColor = companyDetail.invoice_view_color || "#cfcfcf";
      } else if (orderType.id == 4) {
        dynamicColor = companyDetail.purchase_view_color || "#cfcfcf";
      } else if (orderType.id == 5) {
        dynamicColor = companyDetail.purchase_order_color || "#cfcfcf";
      } else if (orderType.id == 6) {
        dynamicColor = companyDetail.return_saled_invoice_color || "#cfcfcf";
      } else if (orderType.id == 7) {
        dynamicColor = companyDetail.return_purchase_invoice_color || "#cfcfcf";
      } else if (orderType.id == 8) {
        dynamicColor = companyDetail.inward_color || "#cfcfcf"; 
      } else if (orderType.id == 9) {
        dynamicColor = companyDetail.dispatch_color || "#cfcfcf";
      } else if (orderType.id == 12) {
        dynamicColor = companyDetail.proforma_invoice_view_color || "#cfcfcf";
      }

      let dynamicTitle = "";
      if (orderType.id == 1) {
        dynamicTitle = companyDetail.quotation_title || "Quotation";
      } else if (orderType.id == 2) {
        dynamicTitle = companyDetail.order_title || "Sales Order";
      } else if (orderType.id == 3) {
        dynamicTitle = companyDetail.invoice_title || "Sales Invoice";
      } else if (orderType.id == 4) {
        dynamicTitle = companyDetail.purchase_title || "Purchase Invoice";
      } else if (orderType.id == 5) {
        dynamicTitle = companyDetail.purchase_order_title || "Purchase Order";
      } else if (orderType.id == 6) {
        dynamicTitle = companyDetail.return_saled_invoice_title || "Return Sales Invoice";
      } else if (orderType.id == 7) {
        dynamicTitle = companyDetail.return_purchase_invoice_title || "Return Purchase Invoice";
      } else if (orderType.id == 8) {
        dynamicTitle = companyDetail.inward_title || "Goods Received Note"; 
      } else if (orderType.id == 9) {
        dynamicTitle = companyDetail.dispatch_title || "Dispatch";
      } else if (orderType.id == 12) {
        dynamicTitle = companyDetail.proforma_invoice_title || "Proforma Invoice";
      }

      const groupedItems = items.reduce((acc, item) => {
        const hsn = item.item_hsn_code?.trim() || 'N/A';
        const gstRate = Number(item.item_gst) || 0;
        const key = `${hsn}|||${gstRate}`;
        if (!acc[key]) {
          acc[key] = {
            item_hsn_code: hsn === 'N/A' ? 'Unknown' : hsn,
            item_gst: gstRate,
            item_total: 0
          };
        }
        acc[key].item_total += Number(item.item_total) || 0;
        return acc;
      }, {});

      const totalGstAmount = 0;

       const dynamicColumns = [];
      if (items && items.length > 0 && productCustom && productCustom.length > 0 && printSetting.product_custom_feilds) {
        const firstProductCustom = productCustom[0] || {};
        for (let key in firstProductCustom) {
          const rowColumnKey = key + "_product_feild_row_column";
          const rowColumnValue = firstProductCustom[rowColumnKey];
          if (rowColumnValue == 2) {
            dynamicColumns.push({
              key: key,
              title: key.replace(/_/g, " ").toUpperCase()
            });
          }
        }
      }
      const dynamicColCount = dynamicColumns.length;

    %>

     <%
        let formattedDate = "";
        let formattedTime = "";

        if (cart.update_Date_time && cart.update_Date_time !== "00-00-00 00:00:00") {
          const date = new Date(cart.update_Date_time);

          if (!isNaN(date.getTime())) {
            const day = ('0' + date.getDate()).slice(-2);
            const month = ('0' + (date.getMonth() + 1)).slice(-2);
            const year = date.getFullYear();

            let hours = date.getHours();
            const minutes = ('0' + date.getMinutes()).slice(-2);
            const ampm = hours >= 12 ? 'PM' : 'AM';

            hours = hours % 12;
            hours = hours ? hours : 12;

            formattedDate = `${day}-${month}-${year}`;
            formattedTime = `${hours}:${minutes} ${ampm}`;
          }
        }
        %>

  <div style="position: relative">
    <div class="watermark" style="position: absolute; top: 27%; left: 25%; opacity: 0.2">
      <% if (company_logo) { %>
      <img src="<%= company_logo %>" alt="" style="width: 50mm; display: none" />
      <% } %>
    </div>
    <div class="header" style="text-align: center; display: none; height:1px !important;">
      <% if (headerImg == "" ) { %>
      <% } else { %>
      <img src="<%= headerImg %>" style="width: 100%;" alt="Header Image">
      <% } %>
    </div>

    <div style="font-size: 5pt !important;">
    <div>
      <% for (let key in cartCustom) {
          const value = cartCustom[key];
          const isValid =
            value != "0" &&
            value != "00:00:00" &&
            value != "0000-00-00 00:00:00" &&
            value != "0000-00-00" &&
            value != null &&
            value != undefined &&
            value != "";
          const isDateTime = key.toLowerCase().includes("date") || key.toLowerCase().includes("time");
          let formType = '';
          let displayOrder = '';
          let idTitle = '';
          const keyParts = key.split("_");
          if (keyParts.length === 2) {
            formType = keyParts[0];
            displayOrder = keyParts[1].split("=")[0];
            idTitle = keyParts[1].split("=")[1];
          }
          if (isValid && (formType == 11 || formType == 12) && displayOrder <= 0) {
        %>
      <div style="page-break-after: always; break-inside: avoid; page-break-inside: avoid">
        <% if (isDateTime) {
            const d = new Date(value);
            const validDate = !isNaN(d.getTime());
          %>
        <%= validDate ? d.toLocaleString() : " Invalid Date" %><br />
        <% } else if (formType == 11) { %>
        <%- value %><br />
        <% } else if (formType == 12) { %>
        <img src="<%- value %>" alt="" style="
              width: 100%;
              max-height: 810px;
              object-fit: cover;
              display: block;
              break-inside: avoid;
            " />
        <br />
        <% } %>
      </div>
      <% } %>
      <% } %>
    </div>

    <table style="
          width: 100%;
          border-collapse: collapse;
          font-family: Poppins, sans-serif;
          background-color: transparent;
        ">
      <tr style="background-color: <%= dynamicColor %>">
        <td style="
              text-align: left;
              font-weight: bold;
              border-right: 0px;
              width: 33%;
            ">
<%= 
  !printSetting.debitCredit 
    ? "" 
    : (orderType.id == 3 || orderType.id == 7) 
        ? "Debit Memo" 
        : (orderType.id == 4 || orderType.id == 6) 
            ? "Credit Memo" 
            : ""
%>

        </td>

        <td style="
              text-align: center;
              font-weight: bold;
              border-inline: 0px;
              border-left: 0px;
              border-right: 0px;
              width: 33%;
            ">
          <%= dynamicTitle %>
        </td>

        <td style="
              text-align: right;
              font-weight: bold;
              border-left: 0px;
              width: 33%;
            ">
          <%= printSetting.orignalDuplicate ? 
        ((cart.cart_number.length > 0 && cart.cart_number != "XXXXXXX") ? "Original" : "Draft") 
        : "" %>
        </td>
      </tr>
      <tr>
        <table>
          <tr>
            <td style="
                  padding-top: 5px;
                  padding-left: 5px;
                  width: 50%;
                  vertical-align: top;
                  border-bottom: 0;
                  border-right: 0;
                  width: 50%;
                  max-width: 50%;
                  word-break: break-word;
                  white-space: normal;
                  overflow-wrap: anywhere;
                ">
              <% if (printSetting.toBuyer) { %>
              <strong>TO/BUYER,</strong><br />
              <strong style="text-transform: uppercase;"><%= cart.to_customer_company_name %>(<%= cart.to_customer_name %>)</strong><br />

              <% if (cart.to_customer_phone.length > 0 && printSetting.ContactMobileNumber) { %>
              <strong>Mo.</strong> <%= cart.to_customer_phone %><span> - </span>
              <% } %>
              <% if (cart.to_customer_email.length > 0) { %>
              <strong>Email:</strong> <%= cart.to_customer_email %><br />
              <% } %>
              <% } %>
              
              <% if (printSetting.billingAddress && cart.Address.length > 0) { %>
              <br /><strong>Billing Address:</strong><br />
              <%= cart.Address %>
              <% } %>
            </td>
            <td style="
                  padding-top: 5;
                  padding-left: 5px;
                  vertical-align: top;
                  border-bottom: 0;
                ">
              <% if (printSetting.orderNo) { %>
              <strong><%= dynamicTitle %> No.:</strong> <%= cart.cart_number %><br />
              <% } %>
              <% if (printSetting.orderDateTime && printSetting.orderTimeOnly) { %>
              <strong><%= dynamicTitle %> Date & Time:</strong>
              <%= formattedDate %> <%= formattedTime %>
              <% } else if (!printSetting.orderDateTime && printSetting.orderTimeOnly) { %>
              <strong><%= dynamicTitle %> Time:</strong>
              <%= formattedTime %>
              <% } else if (printSetting.orderDateTime && !printSetting.orderTimeOnly) { %>
              <strong><%= dynamicTitle %> Date:</strong>
              <%= formattedDate %>
              <% } %>
              <hr style="margin: 0" />
              <% for (let key in cartCustom) {
                  const value = cartCustom[key];
                  const isValid =
                    value != "0" &&
                    value != "00:00:00" &&
                    value != "0000-00-00 00:00:00" &&
                    value != "0000-00-00" &&
                    value != null &&
                    value != undefined &&
                    value != "";
                  const isDateTime = key.toLowerCase().includes("date") || key.toLowerCase().includes("time");
                  let formType = '';
                  let displayOrder = '';
                  let idTitle = '';
                  const keyParts = key.split("_");
                  if (keyParts.length === 2) {
                    formType = keyParts[0];
                    displayOrder = keyParts[1].split("=")[0];
                    idTitle = keyParts[1].split("=")[1];
                  }
                  if (isValid && formType != 11 && formType != 12&& printSetting.cart_custom_feilds) {
                    if (isDateTime) {
                      const d = new Date(value);
                      const validDate = !isNaN(d.getTime());
                      if (validDate) {
                        const day = String(d.getDate()).padStart(2, '0');
                        const month = String(d.getMonth() + 1).padStart(2, '0');
                        const year = d.getFullYear();
                        let hours = d.getHours();
                        const minutes = String(d.getMinutes()).padStart(2, '0');
                        const ampm = hours >= 12 ? 'PM' : 'AM';
                        hours = hours % 12 || 12;
                        const time = String(hours).padStart(2, '0') + ':' + minutes + ' ' + ampm;
                        const formatted = `${day}-${month}-${year} ${time}`;
                      %>
              <strong><%= idTitle %></strong>: <%= formatted %><br />
              <% } else { %>
              <strong><%= idTitle %></strong>: Invalid Date<br />
              <% }
                    } else { %>
              <strong><%= idTitle %></strong>: <%= value %><br />
              <% }
                  }
                } %>
            </td>
          </tr>
        </table>
      </tr>
    </table>

    <div class="invoice-container" style="border-top: 0px; border-bottom: 0; background-color: transparent">
      <table class="invoice-items">
        <thead>
          <tr style="background-color: <%= dynamicColor %>">
            <th style="width: 6%;">No.</th>

             <% if (printSetting.productImage && printSetting.productImageinColumn) { %>
              <th class="text-center" style="width: 7%;">Image</th>
            <% } %>

            <th colspan="2" style="width: <%= dynamicColCount > 0 ? '25%' : '35%' %>;">Particular Description</th>

            <% dynamicColumns.forEach((col, index) => { %>
            <th class="text-center" style="width: 8%;"><%= col.title %></th>
            <% }); %>
            <% if (printSetting.qtycolumn) { %>
            <th style="width: <%= printSetting.hsnColumn ? '8%' : '10%' %>;">Qty<% if (printSetting.unitName) { %> <br/>Unit <% } %></th>
            <% } %>
            <% if (printSetting.rate) { %>
            <th class="text-center" colspan="<%= printSetting.discountColumn ? 1 : 2 %>" style="width: <%= printSetting.discountColumn ? '14%' : '12%' %>;">
              Rate
            </th>

            <% if (printSetting.discountColumn) { %>
            <th class="text-center" style="width: 8%;">Dis(<%= Number(cart.item_discount_type) === 2 ? currency : '%' %>)</th>
            <% } %>
            <% if (totalGstAmount > 0) { %>
            <th>GST(%)</th>
            <% } %>
            <th colspan="2" style="width: <%= (totalGstAmount > 0 || printSetting.gstColumn) ? '14%' : '15%' %>;">Total Amt</th>
            <% } %>
          </tr>
        </thead>
        <tbody>
          <% items.forEach((item, i) => { 
             const productDescBorderStyle = printSetting.productBottomBorder;
             const showLinesBetweenProducts = printSetting.showLinesBetweenProducts;
            %>
          <tr class="invoice-row <%= (productDescBorderStyle && showLinesBetweenProducts) ? 'product-row-border' : '' %>" style="word-break: break-word; white-space: normal; overflow-wrap: anywhere;">

            <td class="bold" style="<%= productDescBorderStyle %>"><%= i + 1 %></td>

                          <% if (printSetting.productImage && printSetting.productImageinColumn) { %>
           <td class="bold" style="<%= productDescBorderStyle %>; text-align:center; padding:4px; vertical-align:middle;">
  <div style="
      max-width: 30px;
      max-height:30px;
      overflow: hidden;
      margin: auto;
    ">
<img
  src="<%= (item.product && item.product.product_img && item.product.product_img.trim() !== '') 
        ? item.product.product_img 
        : `${BACKEND_OF_SMALL_OFFICE_CRM_END_POINT}/no_image.jpeg` %>"
  alt="image"
  style="
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  "
/>
  </div>
            </td>
            <% } %>


            <td colspan="2" style="<%= productDescBorderStyle %>">
              <%= item.item_product_name %><% if (printSetting.productCode && item.item_product_code) { %><br><strong>Product Code:</strong><%= item.item_product_code %><% } %><br>
              <p><%- item.item_product_description.replace(/\n/g, "<br>") %></p>
                 <% if (item.serial_numbers && item.serial_numbers.length > 0) { %>
                <div style="margin-top:5px;">
                  <strong>SN No:</strong><br>

                  <% item.serial_numbers.forEach((sn, index) => { %>
                    <span>
                     <%= sn %>
                    </span><br>
                  <% }) %>
                </div>
              <% } %>
              <% if (productCustom[i] && Object.keys(productCustom[i]).length > 0&& printSetting.product_custom_feilds) { %>
              <% const customFields = productCustom[i] || {}; %>
              <% for (let key in customFields) { %>
              <% 
                        if (key.endsWith("_product_feild_row_column")) continue;
                        
                        const rowColumnKey = key + "_product_feild_row_column";
                        const rowColumnValue = customFields[rowColumnKey];
                        const isColumnField = (rowColumnValue === "2" || rowColumnValue === 2);
                        
                        if (!isColumnField) {
                            let value = customFields[key];
                            const isValid = value !== "0" && value !== "00:00:00" && value !== "0000-00-00 00:00:00" && value !== "0000-00-00" && value != null && value !== undefined && value !== "" && value !== " ";
                            const isDateTime = key.toLowerCase().includes("date") || key.toLowerCase().includes("time");
                            if (isValid) {
                                if (isDateTime) {
                                    const d = new Date(value);
                                    if (!isNaN(d.getTime())) {
                                        const day = String(d.getDate()).padStart(2, '0');
                                        const month = String(d.getMonth() + 1).padStart(2, '0');
                                        const year = d.getFullYear();
                                        let hours = d.getHours();
                                        const minutes = String(d.getMinutes()).padStart(2, '0');
                                        const ampm = hours >= 12 ? 'PM' : 'AM';
                                        hours = hours % 12 || 12;
                                        const time = String(hours).padStart(2, '0') + ':' + minutes + ' ' + ampm;
                                        value = `${day}-${month}-${year} ${time}`;
                                    } else {
                                        value = "Invalid Date";
                                    }
                                }
                    %>
              <strong><%= key %></strong>: <%= value %><br>
              <% } %>
              <% } %>
              <% } %>
              <% } %>


              <% if (printSetting.productImage  && !printSetting.productImageinColumn) { %>
              <div style="
      max-width: 50%;
      overflow: hidden;
      margin: auto;
      text-align: left; 
    ">
<img
  src="<%= (item.product && item.product.product_img && item.product.product_img.trim() !== '') 
        ? item.product.product_img 
        : `${BACKEND_OF_SMALL_OFFICE_CRM_END_POINT}/no_image.jpeg` %>"
  alt="image"
  style="
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left;
    display: block;
    text-align: left; 
  "
/>
  </div>
  <% } %>
            </td>

            <% dynamicColumns.forEach(col => { 
                const customFields = productCustom[i] || {};
                let value = customFields[col.key] || "";
                const isDateTime = col.key.toLowerCase().includes("date") || col.key.toLowerCase().includes("time");
                if (isDateTime && value) {
                    const d = new Date(value);
                    if (!isNaN(d.getTime())) {
                        const day = String(d.getDate()).padStart(2, '0');
                        const month = String(d.getMonth() + 1).padStart(2, '0');
                        const year = d.getFullYear();
                        let hours = d.getHours();
                        const minutes = String(d.getMinutes()).padStart(2, '0');
                        const ampm = hours >= 12 ? 'PM' : 'AM';
                        hours = hours % 12 || 12;
                        const time = String(hours).padStart(2, '0') + ':' + minutes + ' ' + ampm;
                        value = `${day}-${month}-${year} ${time}`;
                    }
                }
            %>
            <td style="text-align: left; word-break: break-word; white-space: normal; overflow-wrap: anywhere;<%= productDescBorderStyle %>"><%= value %></td>
            <% }); %>
             <% if (printSetting.qtycolumn) { %>
            <td style="text-align: right;<%= productDescBorderStyle %>">
              <%= formatNum(item.item_qty, 2) %> <%= printSetting.unitName ? " / " + item.item_unit_name : "" %>
            </td>
             <% } %>
            <% if (printSetting.rate) { %>
            <td class="now-rap-white-space" style="text-align: right;<%= productDescBorderStyle %>" colspan="<%= printSetting.discountColumn ? 1 : 2 %>">
              <%= currency %> <%= formatNum(item.item_rate || 0, 2) %>
            </td>

            <% if (printSetting.discountColumn) { %>
            <td style="text-align: right;<%= productDescBorderStyle %>">
              <% if (Number(cart.item_discount_type) === 2) { %>
                <%= currency %> <%= formatNum(item.item_discount_pr || 0, 2) %>
              <% } else { %>
                <%= formatNum(item.item_discount_pct || 0, 2) %>%
              <% } %>
            </td>
            <% } %>
            <% if (totalGstAmount > 0) { %>
            <td style="text-align: right;<%= productDescBorderStyle %>">
              <%= formatNum(item.item_gst, 2) %>
            </td>
            <% } %>
            <td class="now-rap-white-space" style="text-align: right;<%= productDescBorderStyle %>" colspan="2">
              <%= currency %> <%= formatNum(item.item_total, 2) %>
            </td>
            <% } %>
          </tr>
          <% }) %>

          <% for (let i = items.length; i < 8; i++) { 
            
             const productDescBorderStyle = printSetting.productBottomBorder
  ? "border-top: 0 !important; border-bottom: 0 !important;"
  : "";
            %>
          <tr class="invoice-row" style="break-inside: avoid; page-break-inside: avoid">
            <td class="bold" style="<%= productDescBorderStyle %>">&nbsp;</td>

             <% if (printSetting.productImage && printSetting.productImageinColumn) { %>
            <td style="text-align: right;<%= productDescBorderStyle %>">
            </td>
            <% } %>

            <td colspan="2" style="<%= productDescBorderStyle %>"></td>
            <% dynamicColumns.forEach(col => { %>
            <td style="<%= productDescBorderStyle %>"></td>
            <% }); %>
            <td style="text-align: right;<%= productDescBorderStyle %>"></td>

            <% if (printSetting.rate) { %>
            <td style="text-align: right; <%= productDescBorderStyle %>" colspan="<%= printSetting.discountColumn ? 1 : 2 %>"></td>

             <% if (printSetting.discountColumn) { %>
            <td style="text-align: right; <%= productDescBorderStyle %>"></td>
            <td style="text-align: right; <%= productDescBorderStyle %>"></td>
            <% } %>
            <% if (printSetting.discountColumn == false) { %>
            <td style="text-align: right; <%= productDescBorderStyle %>"></td>
            <% } %>

            <% if (printSetting.qtyColumn == true) { %>
            <td style="text-align: right; <%= productDescBorderStyle %>" colspan="2"></td>
            <% } %>
            <% } %>
          </tr>
          <% } %>

          <tr style="background-color:<%= dynamicColor %>">
            <td style="font-weight: bold; text-align: center;" colspan="<%=
                  3 +
                  dynamicColCount +
                  (printSetting.productImage && printSetting.productImageinColumn ? 1 : 0) + // Image
                  (printSetting.hsnColumn ? 1 : 0) +
                  (printSetting.qtycolumn ? (printSetting.hsnColumn ? 1 : 2): 0) +
                  (printSetting.rate ? (printSetting.discountColumn ? 1 : 2) : 0) +
                  (printSetting.rate && printSetting.discountColumn ? 1 : 0) +
                  (printSetting.rate && printSetting.gstColumn && totalGstAmount > 0 ? 1 : 0) +
                  (printSetting.rate ? ((totalGstAmount > 0 || printSetting.gstColumn) ? 4 : 3) : 0)
                %>">&nbsp;</td>
          </tr>
        </tbody>
      </table>
    </div>

    <table class="total_summery"
     style="
          width: 100%;
          border-collapse: collapse;
          border: 0;
          background-color: transparent;
        ">
      <tr>
        <td colspan="2" style="
              width: 60%;
              vertical-align: top;
              padding-top: 0px;
              padding-left: 5px;
              border-top: 0;
              border-bottom: 0;
              border-right: 0px;
            ">
          <div class="bank-details" style="margin-bottom: 5px; text-align: left">
            <% if (printSetting.termsCondition) { %>
            <strong>Terms & Conditions :</strong>
            <%- cart.cart_terms_and_condition %>
            <% } %>
                      <p class="grand-total-words">
            <strong>Grand Total In Words:</strong>
            <%= numberToword %>
          </p>
           <!--
          <% if (totalGstAmount > 0) { %>
          <p class="grand-total-words">
            <strong>GST Total In Words:</strong>
            <%= gstnumberToword %>
          </p>
          <% } %>
          -->
          <p class="grand-total-words" style="font-weight: bold;">
            <strong>Remarks:</strong>
            <%- cart.cart_remark.replace(/\n/g, "<br>") %>
          </p>
          <% if (printSetting.note) { %>
          <p class="payment-note" style="font-weight: bold">
            <strong>Note: <%= cart.cart_note%></strong>
          </p>
          <% } %>

          </div>

<% if (printSetting.paymentQR && (cart.type == 2 || cart.type == 3 || cart.type == 1)&& qrSvg != null) { %>

  <td style="vertical-align: top;align-items: end; text-align: center; background-color: transparent; border: 0px; border: none;padding: 0px; margin: 0px;">
    <div style="width: 60px; height: 60px; margin: 0px; background-color: transparent;padding: 0px;">
      <%- qrSvg %>
      <center>
        <p style="margin-bottom: 20px;margin: 0px;padding: 0px; display: flex;justify-content: top; align-items: center; font-weight: bold;">
          Payable Amount By UPI
        </p>
      </center>
    </div>
  </td>

<% } %>        </td>

        <% if (printSetting.rate) { 
          
           const productDescBorderStyle = printSetting.productBottomBorder
  ? "border-top: 0 !important; border-bottom: 0 !important;"
  : "";
          %>
        <td colspan="2" style="
              width: 40%;
              vertical-align: top;
              padding: 0px;
              border: 0;
              border-left: 0px;
            ">
          <table style="width: 100%; border-collapse: collapse; border-top: 0">
            <tr style="border-top: 0">
              <td style="font-weight: bold; border-top: 0;<%= productDescBorderStyle %>">Sub Total</td>
              <td class="amount-column now-rap-white-space" style="text-align: right; border-top: 0;<%= productDescBorderStyle %>">
                <%= currency %> <%= formatNum(cart.total_amt, 2) %>
              </td>
            </tr>

            <% if (cart.packing_forwarding_charge && cart.packing_forwarding_charge !== 0) { %>
            <tr>
              <td style="font-weight: bold;<%= productDescBorderStyle %>"><%=cart.packing_forwarding_charge_title || "Packing Charge"%></td>
              <td class="amount-column now-rap-white-space" style="text-align: right;<%= productDescBorderStyle %>">
                <%= currency %> <%= formatNum(cart.packing_forwarding_charge, 2) %>
              </td>
            </tr>
            <% } %>
            <% if (cart.transport_charge && cart.transport_charge !== 0) { %>
            <tr>
              <td style="font-weight: bold;<%= productDescBorderStyle %>"><%=cart.transport_charge_title || "Transport Charge"%></td>
              <td class="amount-column now-rap-white-space" style="text-align: right;<%= productDescBorderStyle %>">
                <%= currency %> <%= formatNum(cart.transport_charge, 2) %>
              </td>
            </tr>
            <% } %>

            <% if (cart.cash_discount && cart.cash_discount !== 0) { 
                const packingVal = parseFloat(cart.packing_forwarding_charge || 0);
                const transportVal = parseFloat(cart.transport_charge || 0);
                const totalVal = parseFloat(cart.total_amt || 0);
                const grossVal = totalVal + packingVal + transportVal;
                const cashDiscAmt = cart.cash_discount_type == 1 ? (grossVal * parseFloat(cart.cash_discount)) / 100 : parseFloat(cart.cash_discount);
                const cashDiscLabel = cart.cash_discount_type == 1 ? `Cash Discount (${cart.cash_discount}%)` : "Cash Discount";
            %>
            <tr>
              <td style="font-weight: bold;<%= productDescBorderStyle %>"><%= cashDiscLabel %></td>
              <td class="amount-column now-rap-white-space" style="text-align: right;<%= productDescBorderStyle %>"><%= currency%> <%= formatNum(cashDiscAmt, 2)%></td>
            </tr>
            <% } %>

            <tr>
              <td style="font-weight: bold;<%= productDescBorderStyle %>">Total Amount</td>
              <td class="amount-column now-rap-white-space" style="text-align: right;<%= productDescBorderStyle %>">
                <%= currency %> <%= formatNum(cart.taxable_amt, 2) %>
              </td>
            </tr>

            <% if (totalGstAmount > 0) { %>
            <% if (companyDetail.state_id === cart.state_id && companyDetail.state_id !== 0) { %>
            <tr>
              <td style="font-weight: bold;<%= productDescBorderStyle %>">CGST</td>
              <td class="amount-column now-rap-white-space" style="text-align: right;<%= productDescBorderStyle %>">
                <%= currency %> <%= formatNum(cart.gst_amt / 2, 2) %>
              </td>
            </tr>
            <tr>
              <td style="font-weight: bold;<%= productDescBorderStyle %>">SGST</td>
              <td class="amount-column now-rap-white-space" style="text-align: right;<%= productDescBorderStyle %>">
                <%= currency %> <%= formatNum(cart.gst_amt / 2, 2) %>
              </td>
            </tr>
            <% } else { %>
            <tr>
              <td style="font-weight: bold;<%= productDescBorderStyle %>">IGST</td>
              <td class="amount-column now-rap-white-space" style="text-align: right;<%= productDescBorderStyle %>">
                <%= currency %> <%= formatNum(cart.gst_amt, 2) %>
              </td>
            </tr>
            <% } %>
            <% } %>

            <% if (cart.tcs_amt && cart.tcs_amt !== 0) { %>
            <tr>
              <td style="font-weight: bold;<%= productDescBorderStyle %>"><%=cart.tcs_title || "TCS"%></td>
              <td class="amount-column now-rap-white-space" style="text-align: right;<%= productDescBorderStyle %>">
                <%= currency %> <%= formatNum(cart.tcs_amt, 2) %>
              </td>
            </tr>
            <% } %>
           
            <!-- <% if (cart.advance_payment && cart.advance_payment !== 0) { %>
            <tr>
              <td style="font-weight: bold;<%= productDescBorderStyle %>">Advance Received Amount</td>
              <td class="amount-column now-rap-white-space" style="text-align: right;<%= productDescBorderStyle %>">
                <%= currency %> <%= formatNum(cart.advance_payment, 2) %>
              </td>
            </tr>
            <% } %> -->

            <% 
                // Calculate how many blank rows needed
                let blankRowsNeeded = 0;
                if (!cart.packing_forwarding_charge || cart.packing_forwarding_charge === 0) blankRowsNeeded++;
                if (!cart.transport_charge || cart.transport_charge === 0) blankRowsNeeded++;
                if (!cart.tcs_amt || cart.tcs_amt === 0) blankRowsNeeded++;
                if (!cart.advance_payment || cart.advance_payment === 0) blankRowsNeeded++;
                // Add blank rows before Round Off
                for (let i = 0; i < blankRowsNeeded; i++) {
              %>
            <tr>
              <td style="<%= productDescBorderStyle %>">&nbsp;</td>
              <td style="<%= productDescBorderStyle %>" class="amount-column">&nbsp;</td>
            </tr>
            <% } %>

            <% if (cart.round_off && cart.round_off !== 0) { %>
            <tr>
              <td style="font-weight: bold;<%= productDescBorderStyle %>">Round Off</td>
              <td class="amount-column now-rap-white-space" style="text-align: right;<%= productDescBorderStyle %>">
                <%= currency %> <%= formatNum(cart.round_off, 2) %>
              </td>
            </tr>
            <% } %>

            <tr style="border-bottom: 0;color:green;">
              <td class="final-total" style="font-weight: bold; font-size: 5.5pt; border-bottom: 0">
                Grand Total
              </td>
              <td class="amount-column final-total now-rap-white-space" style="text-align: right; border-bottom: 0">
                <%= currency %> <%= formatNum(cart.grand_total, 2) %>
              </td>
            </tr>
            <% if (cart.advance_payment && cart.advance_payment !== 0) { %>
            <tr>
              <td style="font-weight: bold;<%= productDescBorderStyle %>">Advance Received Amount</td>
              <td class="amount-column now-rap-white-space" style="text-align: right;<%= productDescBorderStyle %>"><%= currency%> <%= formatNum(cart.advance_payment, 2)%></td>
            </tr>
            <tr style="color:orange;">
              <td style="font-weight: bold;<%= productDescBorderStyle %>">Payable Amount</td>
              <td class="amount-column now-rap-white-space" style="text-align: right;<%= productDescBorderStyle %>"><%= currency%> <%= formatNum(parseFloat(cart.grand_total) - parseFloat(cart.advance_payment), 2)%></td>
            </tr>
            <% } %>
          </table>
        </td>
        <% } %>
      </tr>
    </table>

    <% if (printSetting.rate && totalGstAmount > 0) { %>
    <table class="gst_summery" style="
          width: 100%;
          border-collapse: collapse;
          border: none;
          background-color: transparent;
        ">
      <thead>
        <tr>
          <td rowspan="2" style="border: 1px solid #000">HSN/SAC</td>
          <th rowspan="2" class="text-center" style="border: 1px solid #000">Taxable Value</th>
          <% if (companyDetail.state_id === cart.state_id) { %>
          <th colspan="2" class="text-center" style="border: 1px solid #000">CGST</th>
          <th colspan="2" class="text-center" style="border: 1px solid #000">SGST</th>
          <% } else { %>
          <th colspan="2" class="text-center" style="border: 1px solid #000">IGST</th>
          <% } %>
          <th rowspan="2" class="text-center" style="border: 1px solid #000">Total Tax Amount</th>
        </tr>
        <tr>
          <% if (companyDetail.state_id === cart.state_id) { %>
          <th class="text-center">Rate</th>
          <th class="text-center">Amount</th>
          <th class="text-center">Rate</th>
          <th class="text-center">Amount</th>
          <% } else { %>
          <th class="text-center">Rate</th>
          <th class="text-center">Amount</th>
          <% } %>
        </tr>
      </thead>
      <tbody>
        <% Object.values(groupedItems).forEach((group) => {
            const taxRate = Number(group.item_gst);
            const taxable = Number(group.item_total);
            const isSameState = companyDetail.state_id === cart.state_id;
            const halfRate = taxRate / 2;
            const cgstAmount = isSameState ? (taxable * halfRate) / 100 : 0;
            const sgstAmount = isSameState ? (taxable * halfRate) / 100 : 0;
            const igstAmount = !isSameState ? (taxable * taxRate) / 100 : 0;
            const totalTax = cgstAmount + sgstAmount + igstAmount;
          %>
        <tr>
          <td class="text-left"><%= group.item_hsn_code %></td>
          <td class="text-right now-rap-white-space"><%= currency %> <%= formatNum(taxable, 2) %></td>
          <% if (isSameState) { %>
          <td class="text-center"><%= formatNum(halfRate, 2) %>%</td>
          <td class="text-right now-rap-white-space"><%= currency %> <%= formatNum(cgstAmount, 2) %></td>
          <td class="text-center"><%= formatNum(halfRate, 2) %>%</td>
          <td class="text-right now-rap-white-space"><%= currency %> <%= formatNum(sgstAmount, 2) %></td>
          <% } else { %>
          <td class="text-center"><%= formatNum(taxRate, 2) %>%</td>
          <td class="text-right now-rap-white-space"><%= currency %> <%= formatNum(igstAmount, 2) %></td>
          <% } %>
          <td class="text-right now-rap-white-space"><%= currency %> <%= formatNum(totalTax, 2) %></td>
        </tr>
        <% }) %>

        <% if (cart.packing_forwarding_charge > 0) {
            const taxable = Number(cart.packing_forwarding_charge);
            const staticHsn = '9967';
            const staticGstRate = 18;
            const isSameState = companyDetail.state_id === cart.state_id;
            const halfRate = staticGstRate / 2;
            const cgstAmount = isSameState ? (taxable * halfRate) / 100 : 0;
            const sgstAmount = isSameState ? (taxable * halfRate) / 100 : 0;
            const igstAmount = !isSameState ? (taxable * staticGstRate) / 100 : 0;
            const totalTax = cgstAmount + sgstAmount + igstAmount;
          %>
        <tr>
          <td class="text-left"><%= staticHsn %></td>
          <td class="text-right now-rap-white-space"><%= currency %> <%= formatNum(taxable, 2) %></td>
          <% if (isSameState) { %>
          <td class="text-center"><%= formatNum(halfRate, 2) %>%</td>
          <td class="text-right now-rap-white-space"><%= currency %> <%= formatNum(cgstAmount, 2) %></td>
          <td class="text-center"><%= formatNum(halfRate, 2) %>%</td>
          <td class="text-right now-rap-white-space"><%= currency %> <%= formatNum(sgstAmount, 2) %></td>
          <% } else { %>
          <td class="text-center"><%= formatNum(staticGstRate, 2) %>%</td>
          <td class="text-right now-rap-white-space"><%= currency %> <%= formatNum(igstAmount, 2) %></td>
          <% } %>
          <td class="text-right now-rap-white-space"><%= currency %> <%= formatNum(totalTax, 2) %></td>
        </tr>
        <% } %>

        <% if (cart.transport_charge > 0) {
            const taxable = Number(cart.transport_charge);
            const staticHsn = '9965';
            const staticGstRate = 18;
            const isSameState = companyDetail.state_id === cart.state_id;
            const halfRate = staticGstRate / 2;
            const cgstAmount = isSameState ? (taxable * halfRate) / 100 : 0;
            const sgstAmount = isSameState ? (taxable * halfRate) / 100 : 0;
            const igstAmount = !isSameState ? (taxable * staticGstRate) / 100 : 0;
            const totalTax = cgstAmount + sgstAmount + igstAmount;
          %>
        <tr>
          <td class="text-left"><%= staticHsn %></td>
          <td class="text-right now-rap-white-space"><%= currency %> <%= formatNum(taxable, 2) %></td>
          <% if (isSameState) { %>
          <td class="text-center"><%= formatNum(halfRate, 2) %>%</td>
          <td class="text-right now-rap-white-space"><%= currency %> <%= formatNum(cgstAmount, 2) %></td>
          <td class="text-center"><%= formatNum(halfRate, 2) %>%</td>
          <td class="text-right now-rap-white-space"><%= currency %> <%= formatNum(sgstAmount, 2) %></td>
          <% } else { %>
          <td class="text-center"><%= formatNum(staticGstRate, 2) %>%</td>
          <td class="text-right now-rap-white-space"><%= currency %> <%= formatNum(igstAmount, 2) %></td>
          <% } %>
          <td class="text-right now-rap-white-space"><%= currency %> <%= formatNum(totalTax, 2) %></td>
        </tr>
        <% } %>

        <tr>
          <td class="text-left" style="border-bottom: 0"><strong>Total</strong></td>
          <td class="text-right now-rap-white-space" style="border-bottom: 0">
            <strong><%= currency %> <%= formatNum(cart.taxable_amt, 2) %></strong>
          </td>
          <% if (companyDetail.state_id === cart.state_id) { %>
          <td class="text-right" style="border-bottom: 0"></td>
          <td class="text-right now-rap-white-space" style="border-bottom: 0">
            <strong><%= currency %> <%= formatNum(cart.gst_amt / 2, 2) %></strong>
          </td>
          <td class="text-right" style="border-bottom: 0"></td>
          <td class="text-right now-rap-white-space" style="border-bottom: 0">
            <strong><%= currency %> <%= formatNum(cart.gst_amt / 2, 2) %></strong>
          </td>
          <% } else { %>
          <td class="text-right" style="border-bottom: 0"></td>
          <td class="text-right now-rap-white-space" style="border-bottom: 0">
            <strong><%= currency %> <%= formatNum(cart.gst_amt, 2) %></strong>
          </td>
          <% } %>
          <td class="text-right now-rap-white-space" style="border-bottom: 0">
            <strong><%= currency %> <%= formatNum(cart.gst_amt, 2) %></strong>
          </td>
        </tr>
      </tbody>
    </table>
    <% } %>

    <table style="width: 100%; page-break-inside: avoid; break-inside: avoid">
      <tr style="page-break-inside: avoid; break-inside: avoid">
        <td style="
              width: 60%;
              border-right: 0;
              page-break-inside: avoid;
              break-inside: avoid;
            "></td>
        <td class="amount-column final-total" style="
              text-align: right;
              border-left: 0;
              page-break-inside: avoid;
              break-inside: avoid;
            ">
          <% if (printSetting.signSignatory) { %>
          <p>For, <%= companyDetail.company_name %></p>
          <% if (company_sign) { %>
          <img src="<%= company_sign %>" alt="Company Sign" style="width: 80px" />
          <% } else { %>
          <div style="width: 80px; height: 60px;"></div>
          <% } %>
          <p>(Authorized Signatory)</p>
          <% } %>
        </td>
      </tr>
    </table>

    <div>
      <% for (let key in cartCustom) {
          const value = cartCustom[key];
          const isValid =
            value != "0" &&
            value != "00:00:00" &&
            value != "0000-00-00 00:00:00" &&
            value != "0000-00-00" &&
            value != null &&
            value != undefined &&
            value != "";
          const isDateTime = key.toLowerCase().includes("date") || key.toLowerCase().includes("time");
          let formType = '';
          let displayOrder = '';
          let idTitle = '';
          const keyParts = key.split("_");
          if (keyParts.length === 2) {
            formType = keyParts[0];
            displayOrder = keyParts[1].split("=")[0];
            idTitle = keyParts[1].split("=")[1];
          }
          if (isValid && (formType == 11 || formType == 12) && displayOrder > 0) {
        %>
      <div style="page-break-after: always; page-break-before: always; break-inside: avoid; page-break-inside: avoid">
        <% if (isDateTime) {
            const d = new Date(value);
            const validDate = !isNaN(d.getTime());
          %>
        <%= validDate ? d.toLocaleString() : " Invalid Date" %><br />
        <% } else if (formType == 11) { %>
        <%- value %><br />
        <% } else if (formType == 12) { %>
        <img src="<%- value %>" alt="" style="
              width: 100%;
              max-height: 810px;
              object-fit: cover;
              display: block;
              break-inside: avoid;
            " />
        <br />
        <% } %>
      </div>
      <% } %>
      <% } %>
    </div>
  </div>
</div>
  <div class="footer" style="text-align: center; display: none;">
    <% if (footerImg) { %>
    <img src="<%= footerImg%>" style="width: 100%;" alt="">
    <% } %>
  </div>
</body>

</html>