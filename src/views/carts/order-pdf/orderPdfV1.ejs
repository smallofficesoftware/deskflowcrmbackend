      const isValid = value != "0" && value != "00:00:00" && value != "0000-00-00 00:00:00" && value != "0000-00-00" && value != null && value != undefined && value != "" && value != " ";
      const isDateTime = key.toLowerCase().includes("date") || key.toLowerCase().includes("time");

      let formType = '';
      let displayOrder = '';
      let idTitle = '';

      const keyParts = key.split("_");
      if (keyParts.length === 2) {
          formType = keyParts[0]; 
          displayOrder = keyParts[1].split("=")[0]; 
          idTitle = keyParts[1].split("=")[1]; 
      }
  %>

      <% if (isValid && (formType == 11 || formType == 12) && displayOrder > 0) { %>
      <div style="page-break-after: always; page-break-before: always; break-inside: avoid; page-break-inside: avoid; ">
        <% if (isDateTime) { 
            const d = new Date(value);
            const validDate = !isNaN(d.getTime());
        %>
        <%= validDate ? d.toLocaleString() : "Invalid Date" %><br>
        <% } else if (formType == 11 && printSetting.pageText) { %>
        <%
                let modifiedHtml = value || '';
                if (modifiedHtml) {
                    modifiedHtml = modifiedHtml.replace(
                        /<thead>/gi,
                        '<thead style="background-color:' + dynamicColor + ';">'
                    );
                }
            %>
            <%- modifiedHtml %><br>
        <% } else if (formType == 12 && printSetting.pageURL) { %>

        <img src="<%- value %>" alt="" style="width: 100%; max-height: 810px; object-fit: cover; display: block; break-inside: avoid;">
        <br>
        <% } %>
      </div>
      <% } %>
      <% } %>
    </div>

</div>

    <div class="footer" style="text-align: center; display: none;">
      <img src="<%= footerImg%>" style="width: 100%;" alt="">
    </div>

  </div>

  <script>
    // JavaScript solution to prevent row breaks
    // This runs before print and adds page breaks BEFORE rows that would be cut
    
    window.addEventListener('beforeprint', function() {
      const A4_HEIGHT_PX = 1122; // A4 height in pixels at 96 DPI (297mm)
      const MARGIN_BOTTOM = 50; // Safety margin
      const PAGE_HEIGHT = A4_HEIGHT_PX - MARGIN_BOTTOM;
      
      const rows = document.querySelectorAll('.invoice-row:not(.blank-row)');
      let currentPageHeight = 0;
      let pageNumber = 1;
      
      // First, remove any existing page break classes
      rows.forEach(row => {
        row.classList.remove('force-page-break-before');
      });
      
      // Calculate initial offset (header + customer info)
      const invoiceContainer = document.querySelector('.invoice-container');
      if (invoiceContainer) {
        const containerTop = invoiceContainer.getBoundingClientRect().top;
        currentPageHeight = containerTop;
      }
      
      rows.forEach((row, index) => {
        const rowHeight = row.offsetHeight;
        
        // Check if this row would overflow the page
        if (currentPageHeight + rowHeight > PAGE_HEIGHT) {
          // Add page break before this row
          row.classList.add('force-page-break-before');
          // Reset page height counter
          currentPageHeight = rowHeight;
          pageNumber++;
        } else {
          // Add row height to current page
          currentPageHeight += rowHeight;
        }
      });
      
      console.log('Page break calculation complete. Total pages:', pageNumber);
    });
    
    // Optional: Remove page breaks after printing
    window.addEventListener('afterprint', function() {
      const rows = document.querySelectorAll('.invoice-row');
      rows.forEach(row => {
        row.classList.remove('force-page-break-before');
      });
    });
  </script>

</body>

</html>