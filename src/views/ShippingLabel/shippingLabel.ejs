<!DOCTYPE html>
<html>
<head>
  <style>
    /* body { font-family: Arial; font-size: 12px; } */
    .section { margin-bottom: 12px; }
    table { width: 100%; border-collapse: collapse; }
    th, td { border: 1px solid #000; padding: 6px; }
    .text-end { text-align: right; }
  </style>
</head>
<body>

<div style="font-family:Arial, sans-serif; font-size:13px; line-height:1.3; width:100%;">

  <!-- TO -->
  <div>
    <b style="font-size:15px;">TO</b><br/>

    <b><%= cart.to_customer_name %></b><br/>

    <div style="margin:3px 0; white-space:normal;">
      <%= cart.shipping_address || "" %>,
      <%= cart.city_name %><%= cart.city_name && cart.state_name ? "," : "" %>
      <%= cart.state_name %>
      <%= cart.PinCode ? " - " + cart.PinCode : "" %>
    </div>

    <% if(cart.to_customer_phone){ %>
      Phone: <b><%= cart.to_customer_phone %></b>
    <% } %>
  </div>

  <hr style="margin:8px 0; border:0; border-top:1px solid #000;"/>

  <!-- FROM + QR (TABLE = PRINT SAFE) -->
  <table style="width:100%; border-collapse:collapse;">
    <tr>
      
      <!-- LEFT -->
      <td style="width:75%; vertical-align:top;">
        <b style="font-size:15px;">FROM</b><br/>
        <b><%= company.company_name %></b><br/>

        <div style="margin:3px 0;">
          <%= company.address %>, <%= company.state_name %>
        </div>

        <% if(company.company_contact){ %>
          Phone: <b><%= company.company_contact %></b>
        <% } %>
      </td>

      <!-- RIGHT -->
      <td style="width:25%; text-align:right; vertical-align:top;">
        
        <% if(cart.sr_by_number){ %>
          <div style="margin-bottom:5px;">
            <b>Order #: <%= cart.sr_by_number %></b>
          </div>
        <% } %>

        <div style="width:60px; height:60px; float:right;">
          <%- qrSvg %>
        </div>

      </td>

    </tr>
  </table>

  <!-- PRODUCT -->
  <% if(printSetting?.ProductSection){ %>

  <table style="width:100%; border-collapse:collapse; margin-top:8px; font-size:12.5px;">
    <tr>
      <th style="text-align:left; border-bottom:1px solid #000;">Product</th>
      <th style="text-align:center; border-bottom:1px solid #000;">Qty</th>
      <th style="text-align:right; border-bottom:1px solid #000;">Total</th>
    </tr>

    <% items.forEach(item => { %>
      <tr>
        <td><%= item.item_product_name %></td>
        <td style="text-align:center;"><%= item.item_qty %></td>
        <td style="text-align:right;">₹<%= Number(item.item_total || 0).toLocaleString('en-IN') %></td>
      </tr>
    <% }) %>
  </table>

  <div style="text-align:right; margin-top:5px; font-weight:bold;">
    Grand Total : ₹<%= Number(cart.grand_total || 0).toLocaleString('en-IN') %>
  </div>

  <% } %>

  <!-- TERMS -->
  <% if(dynamicTerms){ %>
    <div style="margin-top:8px; border-top:1px solid #000; padding-top:5px; font-size:11.5px;">
      <%= dynamicTerms %>
    </div>
  <% } %>

</div>

</body>
</html>