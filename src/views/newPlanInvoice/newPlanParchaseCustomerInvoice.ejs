<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Plan Purchase Invoice</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <style>
    @page { size: A4 portrait; margin: 10mm; }
    body {
      font-family: "time new roman", sans-serif;
      font-size: 11px;
      color: #000;
      margin: 0;
      padding: 0;
      line-height: 1.4;
    }
    .invoice { padding: 15px; }
    .text-center { text-align: center; }
    .text-right { text-align: right; }

    .header-img, .footer-img {
      width: 100%;
      max-height: 110px;
      object-fit: contain;
    }

    .billing-table {
      width: 100%;
      border-collapse: collapse;
      margin: 15px 0;
      font-size: 11px;
    }
    .billing-table th, .billing-table td {
      border: 1px solid #ccc;
      padding: 8px 6px;
      vertical-align: top;
    }
    .billing-table th { 
      background: #f8f9fa; 
      text-align: left;
      font-weight: 600;
      text-transform: uppercase;
      font-size: 12px;
    }
    .billing-table td {
      text-align: left;
    }
    .billing-table td:last-child {
      text-align: left;
    }

    .from-to-content div {
      margin-bottom: 2px;
      line-height: 1.3;
    }

    .plan-table {
      width: 100%;
      height: auto;
      border-collapse: collapse;
      margin: 20px 0;
      font-size: 11px;
    }
    .plan-table th, .plan-table td {
      border: 1px solid #ccc;
      padding: 8px 6px;
      text-align: left;
      vertical-align: top;
    }
    .plan-table th { 
      background: #f8f9fa; 
      text-align: center;
    }
    .plan-table td:last-child, .plan-table th:last-child {
      text-align: right;
      font-weight: bold;
    }

    .grand-total {
      margin-top: 15px;
      text-align: right;
      font-weight: 700;
      font-size: 13px;
    }
    .grand-total span {
      background: #e9ecef;
      padding: 8px 12px;
      border: 1px solid #ccc;
      display: inline-block;
      min-width: 140px;
    }

    hr { border: none; border-top: 1px dashed #aaa; margin: 12px 0; }
  </style>
</head>
<body>
  <div class="invoice">

    <!-- HEADER IMAGE -->
    <div class="text-center">
      <img 
    src="data:image/png;base64,<%= headerBase64 %>"
        class="header-img"
        alt="DeskFlow Header"
      />
    </div>
    <hr />
    <!-- INVOICE NUMBER & DATE -->
    <div class="text-left" style="font-size:12px; margin-bottom:10px;">
      <strong>TAX Invoice | Orignal Copy</strong>
 
    </div>

    <div class="text-right" style="font-size:12px; margin-bottom:10px;">
      <div><strong>Invoice No:</strong> <%= getPlanDetails?.invoice_number || '-' %></div>
      <%
        const rawDate = getPlanDetails?.invoice_created_date_time;
        let formattedDate = "-";

        if (rawDate) {
          const d = new Date(rawDate);
          const dd = String(d.getDate()).padStart(2, '0');
          const mm = String(d.getMonth() + 1).padStart(2, '0');
          const yyyy = d.getFullYear();
          formattedDate = `${dd}-${mm}-${yyyy}`;
        }
    %>

<div><strong>Date:</strong> <%= formattedDate %></div>
    </div>

    <!-- FROM / TO IN TABLE FORMAT -->
    <table class="billing-table">
      <thead>
        <tr>
          <th>From</th>
          <th>To</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>
            <div class="from-to-content">
              <div><strong>DESKFLOW SYSTEMS PRIVATE LIMITED</strong></div>
              <div>Aqua Coral, 310, Near Katariya Circle, 2nd Ring Road,</div>
              <div>Rajkot -360005, Gujarat, India</div>
              <div><strong>M:</strong> +91 987 993 1636</div>
              <div><strong>E:</strong>sales@deskflowcrm.com</div>
              <div><strong>CIN:</strong>U62099GJ2025PTC166135</div>
              <div><strong>GST NO:</strong>24AALCD9327M1Z5</div>
              <div><strong>PAN NO:</strong>AALCD9327M</div>
              <div><strong>TAN NO:</strong>RKTD07790G</div>
            </div>
            
          </td>
          <td>
            <div class="from-to-content">
              <div><strong><%= companyData.company_name %></strong></div>
              <div><strong><%= getUserDetails.username %></strong></div>
              <div><%= companyData.company_email %></div>
              <div><strong>M:</strong> +91 <%= companyData.company_contact %></div>
                 <% if (companyData.gst_number) { %> 
                <div><strong>GST:</strong> <%= companyData.gst_number %></div>
                <div><strong>Country:</strong> <%= getCountryDatas.country_name %></div>
                <div><strong>State:</strong> <%= getStateDatas.state_name %></div>
                <div><strong>City:</strong> <%= getCityDatas.city_name %></div>
              <% } %>
            </div>
          </td>
        </tr>
      </tbody>
    </table>

    <hr />

    <!-- PLAN DETAILS TABLE -->
    <table class="plan-table">
      <thead>
        <tr>
          <th>Plan Name</th>
          <th>Plan Amount</th>
          <th>Discount Amount</th>
          <th>GST Amount</th>
          <th>Round Off Amount</th>
         <% if (isCGST_SGST) { %>
      <th>CGST</th>
      <th>SGST</th>
    <% } else { %>
      <th>IGST</th>
    <% } %>
          <th>Payable Amount</th>
        </tr>
      </thead>
      <tbody>

        <% 
          const planAmount = Number(getPlanDetails?.plan_amount || 0);
          const gstAmount = Number(getPlanDetails?.gst_amount || 0);
          const discountAmount = Number(getPlanDetails?.discount_amount || 0);
          const payable = Number(getPlanDetails?.amount || 0);;
          const roundoffamt = Number(getPlanDetails?.round_off_amount || 0);;
        %>

        <tr>
          <td><%= getPlanDetails?.plan_name || '-' %></td>
          <td style="text-align: right;">₹ <%= planAmount.toFixed(2) %></td>
          <td style="text-align: right;">₹ <%= discountAmount.toFixed(2) %></td>
          <td style="text-align: right;">₹ <%= gstAmount.toFixed(2) %></td>
          <td style="text-align: right;">₹ <%= roundoffamt.toFixed(2) %></td>
        <% if (isCGST_SGST) { %>
      <td style="text-align: right;">9%</td>
      <td style="text-align: right;">9%</td>
    <% } else { %>
      <td style="text-align: right;">18%</td>
    <% } %>
          <td style="text-align: right;">₹ <%= payable.toFixed(2) %></td>
        </tr>
      </tbody>
    </table>

    <!-- GRAND TOTAL -->
    <div class="grand-total">
      Grand Total: <span>₹ <%= payable.toFixed(2) %></span>
    </div>

    <hr />

    <!-- FOOTER IMAGE -->
      <div class="text-center">
        <img 
    src="data:image/png;base64,<%= footerBase64 %>"
        class="footer-img"
        alt="DeskFlow Footer"
      />
      </div>
  </div>
</body>
</html>