    "answers": { "a": false, "b": 0, "c": "false" },
    "expectedVisible": ["a", "a_off", "b", "b_off", "c", "c_off"],
    "expectedRequired": []
  },
  {
    "name": "checkbox: never answered counts as unticked",
    "fields": [
      { "key": "agree", "label": "Agree", "type": "checkbox" },
      { "key": "when_off", "label": "When off", "type": "text",
        "conditions": { "match": "all", "rules": [{ "field": "agree", "op": "is", "value": false }] } }
    ],
    "answers": {},
    "expectedVisible": ["agree", "when_off"],
    "expectedRequired": []
  },
  {
    "name": "multi-select: contains / is / is_not / any_of",
    "fields": [
      { "key": "services", "label": "Services", "type": "multi-select", "options": ["Water", "Air", "Soil"] },
      { "key": "water_detail", "label": "Water detail", "type": "text",
        "conditions": { "match": "all", "rules": [{ "field": "services", "op": "contains", "value": "Water" }] } },
      { "key": "air_detail", "label": "Air detail", "type": "text",
        "conditions": { "match": "all", "rules": [{ "field": "services", "op": "is", "value": "air" }] } },
      { "key": "no_soil", "label": "No soil", "type": "text",
        "conditions": { "match": "all", "rules": [{ "field": "services", "op": "is_not", "value": "Soil" }] } },
      { "key": "lab", "label": "Lab", "type": "text",
        "conditions": { "match": "all", "rules": [{ "field": "services", "op": "any_of", "value": ["Soil", "Air"] }] } }
    ],
    "answers": { "services": ["Water", "Air"] },
    "expectedVisible": ["air_detail", "lab", "no_soil", "services", "water_detail"],
    "expectedRequired": []
  },
  {
    "name": "multi-select stored as JSON text is read as a list",
    "fields": [
      { "key": "services", "label": "Services", "type": "multi-select" },
      { "key": "soil_detail", "label": "Soil detail", "type": "text",
