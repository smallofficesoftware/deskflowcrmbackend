      { "key": "either", "label": "Either", "type": "text",
        "conditions": { "match": "any", "rules": [{ "field": "a", "op": "is", "value": "x" }, { "field": "b", "op": "is", "value": "y" }] } }
    ],
    "answers": { "a": "x", "b": "n" },
    "expectedVisible": ["a", "b", "either"],
    "expectedRequired": []
  },
  {
    "name": "match missing defaults to all; empty rules list means always shown",
