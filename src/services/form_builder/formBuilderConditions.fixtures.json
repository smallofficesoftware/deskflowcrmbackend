[
  {
    "name": "no conditions: every field visible, only required ones required",
    "fields": [
      { "key": "name", "label": "Name", "type": "text", "required": true },
      { "key": "note", "label": "Note", "type": "textarea" }
    ],
    "answers": {},
    "expectedVisible": ["name", "note"],
    "expectedRequired": ["name"]
  },
  {
    "name": "is: Reason of rejection shows only when Order is Reject",
    "fields": [
      { "key": "order", "label": "Order", "type": "radio", "options": ["Accept", "Reject"] },
      { "key": "reason", "label": "Reason of rejection", "type": "textarea", "required": true,
        "conditions": { "match": "all", "rules": [{ "field": "order", "op": "is", "value": "Reject" }] } }
    ],
    "answers": { "order": "Reject" },
    "expectedVisible": ["order", "reason"],
    "expectedRequired": ["reason"]
  },
  {
    "name": "is: hidden field is not required even when marked required",
    "fields": [
      { "key": "order", "label": "Order", "type": "radio", "options": ["Accept", "Reject"] },
      { "key": "reason", "label": "Reason of rejection", "type": "textarea", "required": true,
        "conditions": { "match": "all", "rules": [{ "field": "order", "op": "is", "value": "Reject" }] } }
    ],
    "answers": { "order": "Accept", "reason": "left over text" },
    "expectedVisible": ["order"],
    "expectedRequired": []
  },
  {
    "name": "is: text compare is trimmed and case-insensitive",
    "fields": [
      { "key": "order", "label": "Order", "type": "dropdown" },
      { "key": "reason", "label": "Reason", "type": "text",
        "conditions": { "match": "all", "rules": [{ "field": "order", "op": "is", "value": "reject" }] } }
    ],
    "answers": { "order": "  REJECT " },
    "expectedVisible": ["order", "reason"],
    "expectedRequired": []
  },
  {
    "name": "is_not: empty answer counts as 'is not'",
