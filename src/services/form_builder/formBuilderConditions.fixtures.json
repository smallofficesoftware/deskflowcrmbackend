  {
    "name": "switch: false / 0 / 'false' all count as off",
    "fields": [
      { "key": "a", "label": "A", "type": "switch" },
      { "key": "b", "label": "B", "type": "switch" },
      { "key": "c", "label": "C", "type": "switch" },
      { "key": "a_off", "label": "A off", "type": "text",
        "conditions": { "match": "all", "rules": [{ "field": "a", "op": "is", "value": false }] } },
      { "key": "b_off", "label": "B off", "type": "text",
        "conditions": { "match": "all", "rules": [{ "field": "b", "op": "is_not", "value": true }] } },
      { "key": "c_off", "label": "C off", "type": "text",
        "conditions": { "match": "all", "rules": [{ "field": "c", "op": "is", "value": "0" }] } }
