      { "key": "b", "label": "B", "type": "text",
        "conditions": { "rules": [{ "field": "a", "op": "is", "value": "x" }, { "field": "a", "op": "is", "value": "z" }] } },
      { "key": "c", "label": "C", "type": "text", "conditions": { "match": "all", "rules": [] } }
